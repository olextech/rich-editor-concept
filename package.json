{
  "name": "rich-editor-concept",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:library && npm run build:demo",
    "preview": "vite preview",
    "test": "npm run build:library && playwright test",
    "test:backend": "PYTHONPATH=backend DYLD_FALLBACK_LIBRARY_PATH=/opt/homebrew/lib backend/.venv/bin/python -m pytest backend/tests -q",
    "format": "prettier --write src shared build scripts examples docs tests/*.js *.js *.json README.md",
    "format:check": "prettier --check src shared build scripts examples docs tests/*.js *.js *.json README.md",
    "build:library": "vite build --config vite.library.config.js",
    "build:demo": "vite build",
    "prepack": "npm run build:library",
    "test:client": "node --test tests/client.test.js",
    "test:package": "node scripts/check-package.js"
  },
  "dependencies": {
    "@radix-ui/react-dropdown-menu": "2.1.16",
    "@radix-ui/react-label": "2.1.8",
    "@radix-ui/react-popover": "1.1.15",
    "@radix-ui/react-select": "2.2.6",
    "@radix-ui/react-separator": "1.1.8",
    "@radix-ui/react-slot": "1.2.4",
    "@radix-ui/react-tooltip": "1.2.8",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.16.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@tailwindcss/vite": "4.2.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.0.1",
    "ckeditor5": "47.6.1",
    "prettier": "3.9.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwindcss": "4.2.2",
    "typescript": "7.0.2",
    "vite": "8.3.2"
  },
  "engines": {
    "node": ">=22.12"
  },
  "peerDependencies": {
    "ckeditor5": "47.6.1",
    "react": "^18.3.1 || ^19.0.0",
    "react-dom": "^18.3.1 || ^19.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/editor/index.d.ts",
      "import": "./dist/editor/index.js"
    },
    "./styles.css": {
      "types": "./dist/editor/styles.d.ts",
      "default": "./dist/editor/styles.css"
    },
    "./client": {
      "types": "./dist/editor/client.d.ts",
      "import": "./dist/editor/client.js"
    }
  },
  "files": [
    "dist/editor",
    "docs"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/editor/index.js",
  "module": "./dist/editor/index.js",
  "types": "./dist/editor/index.d.ts"
}
